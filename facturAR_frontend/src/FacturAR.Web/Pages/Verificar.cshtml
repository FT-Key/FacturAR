@page "/verificar"
@model FacturAR.Web.Pages.VerificarModel
@{
    Layout = null;
    var comprobante = Model.Comprobante;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verificar comprobante - FacturAR</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/app.css" />
</head>
<body class="bg-light">
    <main class="container py-5" style="max-width: 760px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">Verificar comprobante</h1>
                <p class="text-muted mb-0">Consultá la validez de un CAE emitido por FacturAR.</p>
            </div>
            <a class="btn btn-outline-secondary btn-sm" href="/">Volver al portal</a>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form method="get" action="/verificar" class="row g-3 align-items-end">
                    <div class="col-sm-8">
                        <label for="cae" class="form-label">CAE</label>
                        <input id="cae" name="cae" value="@Model.Cae" class="form-control"
                               inputmode="numeric" maxlength="14" pattern="[0-9]{14}"
                               placeholder="14 dígitos" autocomplete="off" />
                    </div>
                    <div class="col-sm-4">
                        <button type="submit" class="btn btn-primary w-100">Verificar</button>
                    </div>
                </form>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="alert alert-warning" role="alert">@Model.Error</div>
        }

        @if (comprobante is not null)
        {
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success-subtle text-success-emphasis">
                    Comprobante válido
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">CAE</dt>
                        <dd class="col-sm-8"><code>@comprobante.Cae</code></dd>

                        <dt class="col-sm-4">Emisor</dt>
                        <dd class="col-sm-8">@comprobante.RazonSocialEmisor</dd>

                        <dt class="col-sm-4">CUIT emisor</dt>
                        <dd class="col-sm-8">@comprobante.CuitEmisor</dd>

                        <dt class="col-sm-4">Comprobante</dt>
                        <dd class="col-sm-8">@comprobante.TipoComprobanteDescripcion</dd>

                        <dt class="col-sm-4">Punto de venta / número</dt>
                        <dd class="col-sm-8">@comprobante.PuntoVenta.ToString("0000") - @comprobante.Numero.ToString("00000000")</dd>

                        <dt class="col-sm-4">Fecha de emisión</dt>
                        <dd class="col-sm-8">@comprobante.FechaEmision.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Importe total</dt>
                        <dd class="col-sm-8">@comprobante.Moneda @comprobante.ImporteTotal.ToString("N2")</dd>

                        <dt class="col-sm-4">Vencimiento del CAE</dt>
                        <dd class="col-sm-8">@comprobante.CaeVencimiento.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Estado</dt>
                        <dd class="col-sm-8">@comprobante.Estado</dd>
                    </dl>
                </div>
            </div>
        }
    </main>
</body>
</html>
