@page "/verificar"
@model FacturAR.Web.Pages.VerificarModel
@{
    ViewData["Title"] = "Verificar comprobante — FacturAR";
    ViewData["Description"] = "Consultá la validez de un CAE emitido por FacturAR. La verificación es pública y no requiere sesión.";
    var comprobante = Model.Comprobante;
}

<section class="verify" aria-labelledby="verificar-titulo">
    <div class="container container--narrow">
        <div class="verify__head">
            <p class="eyebrow">Verificación pública</p>
            <h1 id="verificar-titulo">Verificar comprobante</h1>
            <p class="section__lead">Consultá la validez de un CAE emitido por FacturAR.</p>
        </div>

        <form method="get" action="/verificar" class="verify-form">
            <div class="field">
                <label for="cae">CAE</label>
                <input id="cae" name="cae" value="@Model.Cae"
                       inputmode="numeric" maxlength="14" pattern="[0-9]{14}"
                       placeholder="14 dígitos" autocomplete="off"
                       aria-describedby="cae-ayuda" />
                <span id="cae-ayuda" class="field__help">Ingresá los 14 dígitos del CAE.</span>
            </div>
            <button type="submit" class="btn btn--primary">Verificar</button>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="alert alert--warning" role="alert">
                <p>@Model.Error</p>
            </div>
        }

        @if (comprobante is not null)
        {
            <div class="result result--ok">
                <div class="result__header">Comprobante válido</div>
                <dl>
                    <dt>CAE</dt>
                    <dd><code>@comprobante.Cae</code></dd>

                    <dt>Emisor</dt>
                    <dd>@comprobante.RazonSocialEmisor</dd>

                    <dt>CUIT emisor</dt>
                    <dd><code>@comprobante.CuitEmisor</code></dd>

                    <dt>Comprobante</dt>
                    <dd>@comprobante.TipoComprobanteDescripcion</dd>

                    <dt>Punto de venta / número</dt>
                    <dd><code>@comprobante.PuntoVenta.ToString("0000") - @comprobante.Numero.ToString("00000000")</code></dd>

                    <dt>Fecha de emisión</dt>
                    <dd>@comprobante.FechaEmision.ToString("dd/MM/yyyy")</dd>

                    <dt>Importe total</dt>
                    <dd>@comprobante.Moneda @comprobante.ImporteTotal.ToString("N2")</dd>

                    <dt>Vencimiento del CAE</dt>
                    <dd>@comprobante.CaeVencimiento.ToString("dd/MM/yyyy")</dd>

                    <dt>Estado</dt>
                    <dd>@comprobante.Estado</dd>
                </dl>
            </div>
        }

        <p class="auth-switch">
            FacturAR es un simulador. El CAE es simulado y no tiene validez fiscal.
            <a href="/">Volver al inicio</a>.
        </p>
    </div>
</section>
