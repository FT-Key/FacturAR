<div class="theme-toggle" role="group" aria-label="Tema de la interfaz">
    <button type="button" class="theme-option" data-theme-option="claro" aria-pressed="false" aria-label="Tema claro">
        <span aria-hidden="true">☀</span>
    </button>
    <button type="button" class="theme-option" data-theme-option="oscuro" aria-pressed="false" aria-label="Tema oscuro">
        <span aria-hidden="true">☾</span>
    </button>
    <button type="button" class="theme-option" data-theme-option="system" aria-pressed="true" aria-label="Tema del sistema">
        <span aria-hidden="true">◐</span>
    </button>
</div>
