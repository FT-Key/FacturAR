@page "/login"
@model FacturAR.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Ingresar — FacturAR";
    ViewData["Description"] = "Acceso de usuarios de empresa a FacturAR.";
}

@section Head {
    <meta name="robots" content="noindex, nofollow" />
}

<section class="auth" aria-labelledby="login-titulo">
    <div class="container auth__inner">
        <div class="auth-card">
            <p class="eyebrow">Acceso de empresa</p>
            <h1 id="login-titulo">Ingresar</h1>
            <p class="auth-card__lead">Accedé para emitir comprobantes, consultar tu historial y administrar tus API keys.</p>

            @if (Model.CuentaActivada)
            {
                <div class="alert alert--success" role="status">
                    <p>Cuenta activada. Ya podés iniciar sesión.</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="alert alert--error" role="alert">
                    <p>@Model.Error</p>
                </div>
            }

            <form method="post" data-envio>
                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" name="Email" value="@Model.Email" type="email"
                           autocomplete="username" required maxlength="256" />
                </div>
                <div class="field">
                    <label for="password">Contraseña</label>
                    <input id="password" name="Password" type="password"
                           autocomplete="current-password" required maxlength="128" />
                </div>
                <button type="submit" class="btn btn--primary" data-envio-texto="Ingresando…">Ingresar</button>
            </form>

            <p class="auth-switch">¿Todavía no tenés cuenta? <a href="/solicitar-alta">Solicitá el alta</a>.</p>
            <div class="auth-links">
                <a href="/">Volver al inicio</a>
                <a href="/manual">Guía de integración</a>
                <a href="/verificar">Verificar comprobante</a>
                <a href="/admin/login">Consola global</a>
            </div>
        </div>
    </div>
</section>
