@page "/admin/login"
@model FacturAR.Web.Pages.Admin.AdminLoginModel
@{
    ViewData["Title"] = "Consola global — FacturAR";
    ViewData["Description"] = "Acceso exclusivo de administradores de FacturAR.";
}

@section Head {
    <meta name="robots" content="noindex, nofollow" />
}

<section class="auth" aria-labelledby="admin-login-titulo">
    <div class="container auth__inner">
        <div class="auth-card">
            <p class="eyebrow">Administración global</p>
            <h1 id="admin-login-titulo">Consola global</h1>
            <p class="auth-card__lead">Acceso exclusivo de administradores de FacturAR.</p>

            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="alert alert--error" role="alert">
                    <p>@Model.Error</p>
                </div>
            }

            <form method="post">
                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" name="Email" value="@Model.Email" type="email"
                           autocomplete="username" required maxlength="256" />
                </div>
                <div class="field">
                    <label for="password">Contraseña</label>
                    <input id="password" name="Password" type="password"
                           autocomplete="current-password" required maxlength="128" />
                </div>
                <button type="submit" class="btn btn--primary">Ingresar</button>
            </form>

            <div class="auth-links">
                <a href="/">Volver al inicio</a>
                <a href="/verificar">Verificar comprobante</a>
                <a href="/login">Acceso de empresa</a>
            </div>
        </div>
    </div>
</section>
