@inject NavigationManager Navigation
@implements IDisposable

<nav aria-label="Navegación principal">
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">FacturAR</a>
        </div>
    </div>

    <input type="checkbox" title="Navigation menu" aria-label="Abrir menú de navegación" class="navbar-toggler" />

    <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
        <div class="nav flex-column">
        <div class="nav-item px-3">
            <a class="nav-link @(Activo("/") ? "active" : null)"
               href="/"
               aria-current="@(Activo("/") ? "page" : null)">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </a>
        </div>

        <AuthorizeView Policy="EmpresaConsulta">
            <Authorized>
                <div class="nav-item px-3">
                    <a class="nav-link @(Activo("/dashboard") ? "active" : null)"
                       href="/dashboard"
                       aria-current="@(Activo("/dashboard") ? "page" : null)">
                        <span class="bi bi-speedometer2-nav-menu" aria-hidden="true"></span> Dashboard
                    </a>
                </div>
                <div class="nav-item px-3">
                    <a class="nav-link @(ActivoComprobantes() ? "active" : null)"
                       href="/comprobantes"
                       aria-current="@(ActivoComprobantes() ? "page" : null)">
                        <span class="bi bi-receipt-nav-menu" aria-hidden="true"></span> Comprobantes
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="EmpresaEmisor">
            <Authorized>
                <div class="nav-item px-3">
                    <a class="nav-link @(Activo("/comprobantes/nuevo") ? "active" : null)"
                       href="/comprobantes/nuevo"
                       aria-current="@(Activo("/comprobantes/nuevo") ? "page" : null)">
                        <span class="bi bi-plus-circle-fill-nav-menu" aria-hidden="true"></span> Emitir comprobante
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="nav-item px-3">
            <a class="nav-link @(Activo("/verificar") ? "active" : null)"
               href="/verificar"
               aria-current="@(Activo("/verificar") ? "page" : null)">
                <span class="bi bi-check2-square-nav-menu" aria-hidden="true"></span> Verificar comprobante
            </a>
        </div>

        <AuthorizeView Policy="EmpresaAdministrador">
            <Authorized>
                <div class="nav-item px-3">
                    <a class="nav-link @(Activo("/api-keys") ? "active" : null)"
                       href="/api-keys"
                       aria-current="@(Activo("/api-keys") ? "page" : null)">
                        <span class="bi bi-key-fill-nav-menu" aria-hidden="true"></span> API keys
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <span class="nav-link text-muted small">@context.User.FindFirst("email")?.Value</span>
                </div>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/logout">Cerrar sesión</a>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <a class="nav-link @(Activo("/login") ? "active" : null)" href="/login">Ingresar</a>
                </div>
                <div class="nav-item px-3">
                    <a class="nav-link @(Activo("/admin/login") ? "active" : null)" href="/admin/login">Consola global</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
        </div>
    </div>
</nav>

@code {
    private string RutaActual
    {
        get
        {
            var ruta = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.TrimEnd('/');
            return ruta.Length == 0 ? "/" : ruta;
        }
    }

    private bool Activo(string href)
        => string.Equals(RutaActual, href, StringComparison.OrdinalIgnoreCase);

    private bool ActivoComprobantes()
        => Activo("/comprobantes")
            || (RutaActual.StartsWith("/comprobantes/", StringComparison.OrdinalIgnoreCase)
                && !RutaActual.StartsWith("/comprobantes/nuevo", StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += AlCambiarUbicacion;
    }

    private void AlCambiarUbicacion(object? sender, LocationChangedEventArgs args)
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Navigation.LocationChanged -= AlCambiarUbicacion;
    }
}
