<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">FacturAR</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="verificar">
                <span class="bi bi-check2-square-nav-menu" aria-hidden="true"></span> Verificar comprobante
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <span class="nav-link text-muted small">@context.User.FindFirst("email")?.Value</span>
                </div>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/logout">Cerrar sesión</a>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">Ingresar</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/login">Consola global</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>