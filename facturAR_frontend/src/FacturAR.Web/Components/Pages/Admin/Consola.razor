@page "/admin"

<PageTitle>Consola global - FacturAR</PageTitle>

<AuthorizeView Policy="AdminGlobal">
    <Authorized>
        <div class="py-4">
            <h1 class="h3 mb-1">Consola global</h1>
            <p class="text-muted mb-0">
                Sesión iniciada como @context.User.FindFirst("email")?.Value
                (@context.User.FindFirst("rolGlobal")?.Value).
            </p>
        </div>
        <div class="alert alert-info" role="status">
            La gestión de solicitudes de alta se habilita en la historia US-27.
        </div>
        <div class="mt-3">
            <a class="btn btn-outline-secondary btn-sm" href="/admin/logout">Cerrar sesión global</a>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>