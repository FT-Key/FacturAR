@page "/admin"

<PageTitle>Consola global - FacturAR</PageTitle>

<AuthorizeView Policy="AdminGlobal">
    <Authorized>
        <div class="py-4">
            <h1 class="h3 mb-1">Consola global</h1>
            <p class="text-muted mb-0">
                Sesión iniciada como @context.User.FindFirst("email")?.Value
                (@context.User.FindFirst("rolGlobal")?.Value).
            </p>
        </div>
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h5">Solicitudes de alta</h2>
                <p class="text-muted small mb-2">Revisá, editá, aprobá o rechazá las empresas que pidieron acceso, y reenviá invitaciones.</p>
                <a class="btn btn-primary btn-sm" href="/admin/solicitudes">Ir a solicitudes</a>
            </div>
        </div>
        <div class="mt-3">
            <a class="btn btn-outline-secondary btn-sm" href="/admin/logout">Cerrar sesión global</a>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>