@page "/"

<PageTitle>FacturAR</PageTitle>

<div class="py-4">
    <h1 class="display-5 fw-semibold">FacturAR</h1>
    <p class="lead">
        Simulador de facturación electrónica de AFIP/ARCA para el Trabajo Final Integrador.
    </p>
    <p class="text-muted">
        Emití comprobantes, consultá su estado y verificá un CAE de forma pública.
    </p>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" href="/verificar">Verificar comprobante</a>
        <a class="btn btn-outline-primary" href="/solicitar-alta">Solicitar alta de empresa</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Emisión</h2>
                <p class="mb-0">Facturas A, B y C con CAE simulado y numeración atómica.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Verificación</h2>
                <p class="mb-0">Consulta pública por CAE para validar comprobantes emitidos.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Integración</h2>
                <p class="mb-0">API REST y SOAP compatibles con el flujo de AFIP.</p>
            </div>
        </div>
    </div>
</div>