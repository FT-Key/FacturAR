@page "/api-keys"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using FacturAR.Contracts.ApiKeys
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "EmpresaAdministrador")]
@inject FacturarApiClient ApiClient
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>API keys - FacturAR</PageTitle>

<div class="py-4">
    <h1 class="h3 mb-1">API keys</h1>
    <p class="text-muted mb-0">
        Generá credenciales para integrar tus sistemas con la API. El valor completo se muestra una sola vez.
    </p>
</div>

@if (_exito is not null)
{
    <div class="alert alert-success" role="status">@_exito</div>
}

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (_valorVisible is not null)
{
    <div class="alert alert-warning" role="alert">
        <h2 class="h5">Copiá tu API key ahora</h2>
        <p class="mb-2">
            Este es el único momento en que vas a ver el valor completo de
            <strong>@_nombreVisible</strong>. No se puede recuperar después.
        </p>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <code id="valor-api-key" class="text-break">@_valorVisible</code>
            <button type="button"
                    class="btn btn-outline-dark btn-sm"
                    onclick="navigator.clipboard.writeText(document.getElementById('valor-api-key').textContent)">
                Copiar
            </button>
        </div>
    </div>
}

<section class="card mb-4" aria-labelledby="titulo-crear">
    <div class="card-body">
        <h2 id="titulo-crear" class="h5">Nueva API key</h2>
        <EditForm Model="Nuevo!" FormName="crear" OnValidSubmit="CrearAsync" Enhance>
            <DataAnnotationsValidator />
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-6">
                    <label class="form-label" for="nombre">Nombre</label>
                    <InputText id="nombre"
                               class="form-control"
                               maxlength="64"
                               autocomplete="off"
                               placeholder="Ecommerce"
                               @bind-Value="Nuevo!.Nombre" />
                    <ValidationMessage For="() => Nuevo!.Nombre" class="text-danger small" />
                </div>
                <div class="col-12 col-md-auto">
                    <button type="submit" class="btn btn-primary">Crear API key</button>
                </div>
            </div>
        </EditForm>
    </div>
</section>

<section class="card" aria-labelledby="titulo-listado">
    <div class="card-body">
        <h2 id="titulo-listado" class="h5">Tus API keys</h2>

        @if (_listado is null)
        {
            <p class="text-muted mb-0">Cargando…</p>
        }
        else if (_listado.Items.Count == 0)
        {
            <div class="alert alert-light border mb-0" role="status">
                Todavía no tenés API keys. Creá la primera para empezar a integrarte.
            </div>
        }
        else
        {
            <form method="post" @formname="gestion" @onsubmit="GestionarAsync" data-enhance>
                <AntiforgeryToken />
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Nombre</th>
                                <th scope="col">Prefijo</th>
                                <th scope="col">Estado</th>
                                <th scope="col">Creada</th>
                                <th scope="col">Último uso</th>
                                <th scope="col"><span class="visually-hidden">Acciones</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var apiKey in _listado.Items)
                            {
                                <tr>
                                    <td>@apiKey.Nombre</td>
                                    <td class="font-monospace">@apiKey.Prefix</td>
                                    <td>
                                        <span class="badge @ClaseEstado(apiKey.Activa)">@Estado(apiKey.Activa)</span>
                                        @if (apiKey.RevocadaAt is DateTime revocada)
                                        {
                                            <div class="small text-muted">Revocada @Fecha(revocada)</div>
                                        }
                                        @if (apiKey.RegeneradaAt is DateTime regenerada)
                                        {
                                            <div class="small text-muted">Regenerada @Fecha(regenerada)</div>
                                        }
                                    </td>
                                    <td>@Fecha(apiKey.CreatedAt)</td>
                                    <td>@(apiKey.UltimoUso is DateTime ultimo ? Fecha(ultimo) : "Nunca")</td>
                                    <td class="text-end">
                                        <div class="d-flex flex-wrap justify-content-end gap-2">
                                            @if (apiKey.Activa)
                                            {
                                                <button type="submit"
                                                        name="Accion"
                                                        value="revocar:@apiKey.Id"
                                                        class="btn btn-outline-danger btn-sm"
                                                        onclick="return confirm('¿Revocar esta API key? Dejará de autenticar de inmediato.')">
                                                    Revocar
                                                </button>
                                            }
                                            <button type="submit"
                                                    name="Accion"
                                                    value="regenerar:@apiKey.Id"
                                                    class="btn btn-outline-primary btn-sm"
                                                    onclick="return confirm('Se generará un valor nuevo y el anterior dejará de autenticar. ¿Continuar?')">
                                                Regenerar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </form>
        }
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    [SupplyParameterFromForm(FormName = "crear")]
    private CrearModelo? Nuevo { get; set; }

    [SupplyParameterFromForm(FormName = "gestion")]
    private string? Accion { get; set; }

    private ApiKeyListResponse? _listado;
    private string? _valorVisible;
    private string? _nombreVisible;
    private string? _exito;
    private string? _error;

    private string? Cookie => HttpContext?.Request.Cookies.TryGetValue(NombreCookieEmpresa, out var valor) == true
        && !string.IsNullOrEmpty(valor)
            ? $"{NombreCookieEmpresa}={valor}"
            : null;

    private string NombreCookieEmpresa =>
        Configuration["Auth:Cookie:NombreContribuyente"] ?? ".FacturAR.Contribuyente";

    protected override async Task OnInitializedAsync()
    {
        var usuario = AuthenticationState is null ? null : (await AuthenticationState).User;
        if (usuario is null || !usuario.HasClaim("rol", "Administrador"))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        Nuevo ??= new CrearModelo();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var resultado = await ApiClient.ListarApiKeysAsync(Cookie);
        if (resultado.SinSesion)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (resultado.Exitoso)
        {
            _listado = resultado.Valor;
        }
        else
        {
            _error = resultado.Mensaje;
        }
    }

    private async Task CrearAsync()
    {
        if (Nuevo is null)
        {
            return;
        }

        var resultado = await ApiClient.CrearApiKeyAsync(Cookie, new CrearApiKeyRequest(Nuevo.Nombre));
        if (resultado.SinSesion)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!resultado.Exitoso || resultado.Valor is null)
        {
            _error = resultado.Mensaje;
            return;
        }

        _error = null;
        _exito = "API key creada.";
        MostrarValor(resultado.Valor.Nombre, resultado.Valor.Valor);
        Nuevo.Nombre = string.Empty;
        await CargarAsync();
    }

    private async Task GestionarAsync()
    {
        if (string.IsNullOrWhiteSpace(Accion))
        {
            return;
        }

        var partes = Accion.Split(':', 2);
        if (partes.Length != 2 || !Guid.TryParse(partes[1], out var id))
        {
            _error = "La acción solicitada no es válida.";
            return;
        }

        switch (partes[0])
        {
            case "revocar":
                var revocada = await ApiClient.RevocarApiKeyAsync(Cookie, id);
                if (revocada.SinSesion)
                {
                    Navigation.NavigateTo("/login");
                    return;
                }

                if (!revocada.Exitoso)
                {
                    _error = revocada.Mensaje;
                    return;
                }

                _error = null;
                _exito = "API key revocada.";
                await CargarAsync();
                break;

            case "regenerar":
                var regenerada = await ApiClient.RegenerarApiKeyAsync(Cookie, id);
                if (regenerada.SinSesion)
                {
                    Navigation.NavigateTo("/login");
                    return;
                }

                if (!regenerada.Exitoso || regenerada.Valor is null)
                {
                    _error = regenerada.Mensaje;
                    return;
                }

                _error = null;
                _exito = "API key regenerada. El valor anterior dejó de ser válido.";
                MostrarValor(regenerada.Valor.Nombre, regenerada.Valor.Valor);
                await CargarAsync();
                break;

            default:
                _error = "La acción solicitada no es válida.";
                break;
        }
    }

    private void MostrarValor(string nombre, string valor)
    {
        _nombreVisible = nombre;
        _valorVisible = valor;
    }

    private static string Estado(bool activa)
        => activa ? "Activa" : "Revocada";

    private static string ClaseEstado(bool activa)
        => activa ? "text-bg-success" : "text-bg-secondary";

    private static string Fecha(DateTime fecha)
        => fecha.ToUniversalTime().ToString("dd/MM/yyyy HH:mm 'UTC'", CultureInfo.InvariantCulture);

    private sealed class CrearModelo
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(64, MinimumLength = 1, ErrorMessage = "El nombre debe tener entre 1 y 64 caracteres.")]
        public string Nombre { get; set; } = string.Empty;
    }
}
