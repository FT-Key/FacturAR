    {
      "name": "Comprobantes",
      "item": [
        {
          "name": "Verificar CAE existente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 o 404', () => pm.expect([200, 404]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Expone datos públicos del comprobante', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('cae');",
                  "    pm.expect(body).to.have.property('tipoComprobanteDescripcion');",
                  "    pm.expect(body).to.not.have.property('idempotencyKey');",
                  "  });",
                  "} else {",
                  "  pm.test('Devuelve código de no encontrado', () => pm.expect(pm.response.json().codigo).to.eql('COMPROBANTE_NO_ENCONTRADO'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/comprobantes/verificar/{{caeExistente}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "comprobantes", "verificar", "{{caeExistente}}"]
            },
            "description": "Verificación pública por CAE. Usar un CAE de 14 dígitos existente en la base para obtener 200."
          },
          "response": []
        },
        {
          "name": "Verificar CAE con formato inválido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('Devuelve CAE_INVALIDO', () => pm.expect(pm.response.json().codigo).to.eql('CAE_INVALIDO'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/comprobantes/verificar/123",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "comprobantes", "verificar", "123"]
            },
            "description": "CAE que no tiene 14 dígitos."
          },
          "response": []
        },
        {
          "name": "Verificar CAE inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 404', () => pm.response.to.have.status(404));",
                  "pm.test('Devuelve COMPROBANTE_NO_ENCONTRADO', () => pm.expect(pm.response.json().codigo).to.eql('COMPROBANTE_NO_ENCONTRADO'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/comprobantes/verificar/99999999999999",
              "host": ["{{baseUrl}}"],
