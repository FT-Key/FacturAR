      "name": "Invitaciones",
      "description": "US-28. Activación pública de la cuenta con el token del email de aprobación.",
      "item": [
        {
          "name": "Validar invitación",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Solo expone datos públicos', () => pm.expect(Object.keys(pm.response.json()).sort()).to.eql(['emailEnmascarado', 'expiraAt', 'razonSocial']));"
                ]
