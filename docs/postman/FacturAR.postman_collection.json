            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/invitaciones/{{tokenInvitacion}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "invitaciones", "{{tokenInvitacion}}"]
            },
            "description": "Pegar en `tokenInvitacion` el token del link del email (`/activar?token=…`). Devuelve solo razón social, email enmascarado y vencimiento."
          },
          "response": []
        },
