                  "pm.test('Devuelve estado', () => pm.expect(pm.response.json()).to.have.property('status'));",
                  "pm.test('Informa la versión y el commit', () => { const cuerpo = pm.response.json(); pm.expect(cuerpo).to.have.property('version'); pm.expect(cuerpo).to.have.property('commit'); });"
