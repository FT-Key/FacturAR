          "name": "Aceptar con contraseña débil",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400 PASSWORD_DEBIL', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().codigo).to.eql('PASSWORD_DEBIL');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/invitaciones/{{tokenInvitacion}}/aceptar",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "invitaciones", "{{tokenInvitacion}}", "aceptar"]
            },
            "description": "La política exige 10 caracteres, una letra, un número y que no sea trivial. La invitación sigue vigente.",
