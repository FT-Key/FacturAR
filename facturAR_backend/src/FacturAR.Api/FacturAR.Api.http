@FacturAR_Api_HostAddress = http://localhost:5171

GET {{FacturAR_Api_HostAddress}}/
Accept: application/json

###

GET {{FacturAR_Api_HostAddress}}/health
Accept: application/json

###

GET {{FacturAR_Api_HostAddress}}/health/live
Accept: application/json

###

GET {{FacturAR_Api_HostAddress}}/v1/comprobantes/verificar/12345678901234
Accept: application/json

###

# Emisión (US-05): pegar una API key válida de la empresa y una Idempotency-Key única por request.
@apiKey = fak_000000000000_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
@idempotencyKey = pedido-2026-0001

POST {{FacturAR_Api_HostAddress}}/v1/comprobantes
X-Api-Key: {{apiKey}}
Idempotency-Key: {{idempotencyKey}}
Content-Type: application/json

{
  "tipoComprobante": 11,
  "puntoVenta": 1,
  "receptor": {
    "documentoTipo": "99",
    "documentoNumero": "0",
    "razonSocial": "Consumidor Final",
    "condicionIva": 5
  },
  "items": [
    {
      "descripcion": "Curso de programación",
      "cantidad": 1,
      "precioUnitario": 10000,
      "alicuotaIva": 0
    }
  ],
  "observaciones": "Venta de prueba"
}

###

# Consultas (US-09): aceptan API key o cookie de empresa. Pegar una API key válida de la empresa.
@comprobanteId = 6ae24e50-1c3e-4f0a-9f3e-9d2f0b7a1c22

GET {{FacturAR_Api_HostAddress}}/v1/comprobantes?page=1&pageSize=20&desde=2026-10-01&hasta=2026-10-31&tipo=11
X-Api-Key: {{apiKey}}
Accept: application/json

###

GET {{FacturAR_Api_HostAddress}}/v1/comprobantes/{{comprobanteId}}
X-Api-Key: {{apiKey}}
Accept: application/json

###

# PDF (US-10): devuelve application/pdf con Content-Disposition: inline. No altera el comprobante.
GET {{FacturAR_Api_HostAddress}}/v1/comprobantes/{{comprobanteId}}/pdf
X-Api-Key: {{apiKey}}
Accept: application/pdf

###

GET {{FacturAR_Api_HostAddress}}/v1/comprobantes/ultimo-autorizado?tipo=11&puntoVenta=1
X-Api-Key: {{apiKey}}
Accept: application/json

###

POST {{FacturAR_Api_HostAddress}}/v1/solicitudes-alta
Content-Type: application/json

{
  "razonSocial": "Empresa Demo S.A.",
  "cuit": "20123456786",
  "condicionIva": 1,
  "nombreSolicitante": "Ana Pérez",
  "email": "solicitante@demo.com",
  "telefono": "+54 11 5555-1234",
  "domicilio": "Av. Corrientes 1234",
  "ciudad": "Ciudad Autónoma de Buenos Aires",
  "provincia": "Buenos Aires",
  "codigoPostal": "C1043",
  "mensaje": "Queremos emitir facturas A y B.",
  "aceptaTerminos": true
}

###

# Consola global (US-27): iniciar sesión y copiar la cookie .FacturAR.Admin en @adminCookie.
@adminCookie = .FacturAR.Admin=PEGAR_COOKIE
@solicitudId = 00000000-0000-0000-0000-000000000000

POST {{FacturAR_Api_HostAddress}}/v1/admin/auth/login
Content-Type: application/json

{
  "email": "admin@facturar.local",
  "password": "CAMBIAR"
}

###

GET {{FacturAR_Api_HostAddress}}/v1/admin/solicitudes?estado=Pendiente&page=1&pageSize=20
Cookie: {{adminCookie}}

###

GET {{FacturAR_Api_HostAddress}}/v1/admin/solicitudes/{{solicitudId}}
Cookie: {{adminCookie}}

###

PUT {{FacturAR_Api_HostAddress}}/v1/admin/solicitudes/{{solicitudId}}
Cookie: {{adminCookie}}
Content-Type: application/json

{
  "razonSocial": "Empresa Demo S.A.",
  "condicionIva": 1,
  "email": "solicitante@demo.com",
  "telefono": "+54 11 5555-1234",
  "domicilio": "Av. Corrientes 1234"
}

###

POST {{FacturAR_Api_HostAddress}}/v1/admin/solicitudes/{{solicitudId}}/aprobar
Cookie: {{adminCookie}}

###

POST {{FacturAR_Api_HostAddress}}/v1/admin/solicitudes/{{solicitudId}}/rechazar
Cookie: {{adminCookie}}
Content-Type: application/json

{
  "motivo": "Datos fiscales incompletos"
}

###

POST {{FacturAR_Api_HostAddress}}/v1/admin/solicitudes/{{solicitudId}}/reenviar-invitacion
Cookie: {{adminCookie}}

###

# Activación (US-28): pegar el token del link /activar?token=... del email de aprobación.
@tokenInvitacion = PEGAR_TOKEN
@passwordNueva = CAMBIAR

GET {{FacturAR_Api_HostAddress}}/v1/invitaciones/{{tokenInvitacion}}
Accept: application/json

###

POST {{FacturAR_Api_HostAddress}}/v1/invitaciones/{{tokenInvitacion}}/aceptar
Content-Type: application/json

{
  "password": "{{passwordNueva}}",
  "confirmacionPassword": "{{passwordNueva}}"
}

###

# Notas de crédito y débito (US-08): pegar el id de una factura emitida.
@facturaOriginalId = 00000000-0000-0000-0000-000000000000

POST {{FacturAR_Api_HostAddress}}/v1/comprobantes
X-Api-Key: {{apiKey}}
Idempotency-Key: nota-credito-0001
Content-Type: application/json

{
  "tipoComprobante": 3,
  "puntoVenta": 1,
  "comprobanteOriginalId": "{{facturaOriginalId}}",
  "receptor": {
    "documentoTipo": "CUIT",
    "documentoNumero": "30712345671",
    "razonSocial": "Cliente S.A.",
    "condicionIva": 1
  },
  "items": [
    { "descripcion": "Corrección de la factura", "cantidad": 1, "precioUnitario": 1000, "alicuotaIva": 21 }
  ]
}

###
