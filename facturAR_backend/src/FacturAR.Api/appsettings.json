{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017/?serverSelectionTimeoutMS=3000",
    "DatabaseName": "facturar",
    "InitializeIndexes": true
  },
  "Auth": {
    "Cookie": {
      "Dominio": "",
      "NombreContribuyente": ".FacturAR.Contribuyente",
      "NombreAdmin": ".FacturAR.Admin",
      "HorasSesionEmpresa": 8,
      "HorasSesionAdmin": 2
    },
    "PasswordHashIterations": 600000,
    "Login": {
      "MaxIntentosFallidos": 5,
      "MinutosBloqueo": 15,
      "RateLimitPorIp": 10,
      "VentanaRateLimitMinutos": 5
    }
  },
  "BootstrapAdmin": {
    "Email": "",
    "Nombre": ""
  },
  "RateLimit": {
    "SolicitudAlta": {
      "PorIp": 5,
      "PorEmail": 3,
      "ConfiarEnProxy": false
    },
    "Invitacion": {
      "ValidacionesPorIp": 20,
      "ActivacionesPorIp": 10
    }
  },
  "Email": {
    "From": "facturar@localhost",
    "FromName": "FacturAR",
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "UseSsl": true,
    "DirectorioSalida": "emails",
    "TimeoutSegundos": 15
  },
  "Portal": {
    "BaseUrl": "http://localhost:5116"
  },
  "Admin": {
    "NotificationEmail": ""
  }
}